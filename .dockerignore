.git
.gitignore
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.log
streamlit.log
bt_stats.log

# Temporary / raw backup text files
raw_part*.txt
*.pre_repair_backup.csv
*.pre_update_backup.csv
backtest_*.txt
spatial_backtest*.txt
pattern_backtest*.txt
keys_MS_validation.txt
charts_comparison_backtest.txt
plan_bootstrap.txt

# Virtual environments
.venv/
venv/
ENV/

# Source datasets kept for provenance -- the app only ever reads ghana_lotto_history.csv
kaigee_history.csv
ghana_hybrid_scraped.csv

# Torch checkpoints. The served app reads artifacts/deep_*.npz (NumPy) instead; the
# .pt files matter only when resuming training, which the runtime image can't do.
artifacts/*.pt

# Local Streamlit disk cache -- rebuilt at runtime, must not be baked into the image
.streamlit/cache/
.cache/

# Docs and scratch
REPORT.md
DEPLOYMENT.md
.devcontainer/
